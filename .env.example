# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/dineq_dev
TEST_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/dineq_test
PORT=3000
APP_ORIGIN=http://localhost:5173
SESSION_TTL_SECONDS=3600
NODE_ENV=development
COOKIE_SECURE=false
SEED_DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD

# Local Docker Compose only; use URL-safe characters in POSTGRES_PASSWORD.
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_URL_SAFE_PASSWORD
COMPOSE_PORT=8080
COMPOSE_APP_ORIGIN=http://localhost:8080

# E2E harness uses its own servers and TEST_DATABASE_URL.
E2E_API_PORT=3100
E2E_WEB_PORT=5273
# Vite development overrides; E2E sets these for its child Vite process.
VITE_DEV_PORT=5173
API_PROXY_TARGET=http://localhost:3000
